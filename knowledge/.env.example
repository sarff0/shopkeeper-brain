# ============ LLM / Embedding ============
# 兼容 OpenAI 协议的接口，例如阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_BASE=
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=qwen-plus
LLM_DEFAULT_TEMPERATURE=0.1
MODEL=
ITEM_MODEL=
VL_MODEL=
KG_MODEL=

# ============ Milvus ============
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=chunks
ITEM_NAME_COLLECTION=item_names
ENTITY_NAME_COLLECTION=entity_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.3
EMBEDDING_DIM=1024

# ============ Neo4j ============
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ============ MongoDB ============
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=shopkeeper

# ============ MinIO ============
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=knowledge

# ============ BGE 本地模型 ============
BGE_M3_PATH=BAAI/bge-m3
BGE_M3=
BGE_RERANKER_LARGE=BAAI/bge-reranker-large
BGE_DEVICE=cuda
BGE_FP16=true
BGE_RERANKER_DEVICE=cuda
BGE_RERANKER_FP16=true
EMBEDDING_MODEL=bge-m3

# ============ 联网搜索（MCP） ============
MCP_DASHSCOPE_BASE_URL=

# ============ 调试 ============
ITEM_NAME_DIAG=false
